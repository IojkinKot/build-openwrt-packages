#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1

PROG=/usr/bin/vhusbd
CONFIGNAME=/etc/virtualhere.conf

start_service() {
	local enabled

	config_load vhusbd
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONFIGNAME"
	procd_set_param file "$CONFIGNAME"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger vhusbd
}
